<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>Query Studio</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<!--
	  The Capacitor template still ships armv7 here. Capacitor 7 targets iOS 14 and
	  up, which is arm64-only, and App Store Connect rejects a build that declares a
	  32-bit capability it cannot satisfy.
	-->
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>

	<!--
	  capacitor.config.ts sets `limitsNavigationsToAppBoundDomains: true`, and WebKit
	  requires the matching declaration here - without it the WKWebView refuses to
	  load anything and the app opens to a blank screen. Everything is served from
	  the bundle over capacitor://localhost, so localhost is the only entry, and the
	  list being this short is the point: the WebView is not permitted to navigate
	  anywhere else even if a data file somehow contained a link.
	-->
	<key>WKAppBoundDomains</key>
	<array>
		<string>localhost</string>
	</array>

	<!--
	  Getting a multi-gigabyte file onto an iPhone is most of the problem. These two
	  keys put the app's Documents folder in the Files app, so a file can be dropped
	  in over AirDrop, iCloud or a cable and then picked up here. Files opened this
	  way are read in place rather than copied, which matters when the file is larger
	  than the free space left on the device.
	-->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
